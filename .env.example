# Secrets live ONLY here (this file is an example; your real .env is git-ignored).
# The stub provider needs no keys at all — `make demo` works without this file.

# Provider selection also lives in config; env wins over config files.
# PB_PROVIDER=openai-compatible

# OpenAI-compatible endpoint (works with OpenAI, Gemini's compatible endpoint, local servers, ...)
# PB_LLM_BASE_URL=https://api.openai.com/v1
# PB_LLM_API_KEY=
# PB_LLM_MODEL=gpt-4o-mini
